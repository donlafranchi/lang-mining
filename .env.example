# Copy to .env.local for local work. In Vercel, set these as project environment variables.
ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Single-user gate. The app refuses to serve in production without it.
APP_PASSCODE=

# Vercel Cron sends this as a bearer token to /api/cron/retention
CRON_SECRET=

# Days before stored source text is deleted. Default 7.
RETENTION_DAYS=7
