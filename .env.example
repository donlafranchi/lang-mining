# Copy to .env.local for local work. In Vercel, set these as project environment variables.
ANTHROPIC_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The owner password to start with. The first sign-in ever, with this as the password and the name you type, creates the
# owner account. After that each person signs in with their own name and password, and this is only for an empty database.
APP_PASSCODE=

# Signs the session cookie. Required in production, the app refuses to serve without it. Make one with: openssl rand -hex 32
SESSION_SECRET=

# Language analysis service (see analysis/README.md). Leave both unset to build lessons without it.
ANALYSIS_URL=
ANALYSIS_KEY=

# Phone notifications when a lesson finishes. Make the pair with: npx web-push generate-vapid-keys
# Leave unset to switch notifications off. VAPID_SUBJECT is a contact such as mailto:you@example.com.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
