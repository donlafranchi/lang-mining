# Copy to .env.local for local work. In Vercel, set these as project environment variables.
ANTHROPIC_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The owner passcode. The first sign-in ever, with this passcode and the name you type, creates the owner account.
# After that each person signs in with their own name and passcode, and this is only a fallback for an empty database.
APP_PASSCODE=

# Signs the session cookie. Required in production, the app refuses to serve without it. Make one with: openssl rand -hex 32
SESSION_SECRET=
